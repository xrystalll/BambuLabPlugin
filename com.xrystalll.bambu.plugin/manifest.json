{
    "name": "Bambu",
    "uuid": "com.xrystalll.bambu",
    "version": "1.1.0",
    "author": "xrystalll",
    "entry": "backend/plugin.cjs",
    "description": "Flexbar plugin for monitoring the status of Bambu Lab printers",
    "repo": "https://github.com/xrystalll/BambuLabPlugin",
    "sdk": {
        "version": "1.0.7"
    },
    "software": {
        "minimumVersion": "1.3.0"
    },
    "os": [
        {
            "platform": "mac",
            "minimumVersion": "10.15"
        },
        {
            "platform": "windows",
            "minimumVersion": "10"
        }
    ],
    "device": [
        {
            "name": "flexbar",
            "version": "1.0.0"
        }
    ],
    "configPage": "",
    "keyLibrary": {
        "title": "$PluginName",
        "style": {
            "icon": "data:image/png;base64,"
        },
        "children": [
          {
              "title": "$Designer.Title",
              "tip": "$Designer.Tip",
              "cid": "com.xrystalll.bambu.monitor",
              "config": {
                  "keyType": "default", 
                  "clickable": false,
                  "platform": [
                      "windows",
                      "mac"
                  ]
              },
              "style": {
                  "bgColor": "#000",
                  "showTitle": true,
                  "icon": "data:image/png;base64,",
                  "iconSize": 28,
                  "iconPos": {
                    "X": 6,
                    "Y": 52
                  },
                  "titlePos": {
                    "X": 18,
                    "Y": 55
                  },
                  "width": 1000
              },
              "data": {}
          }
        ]
    },
    "local": {
        "en": {
            "PluginName": "Bambu Lab",
            "Designer": {
                "Title": "Bambu monitor",
                "Tip": "Monitoring Bambu Lab printing status",
                "UI": {
                    "Title": "Enter printer data",
                    "Save": "Save",
                    "SaveSuccess": "Config saved",
                    "IP": "Printer IP",
                    "AccessCode": "Access code",
                    "SN": "Printer serial number"
                }
            }
        }
    }
}